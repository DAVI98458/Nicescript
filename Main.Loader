KeyBox.Font = Enum.Font.Gotham
KeyBox.TextSize = 14
KeyBox.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
KeyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
KeyBox.Parent = Frame

local KeyCorner = Instance.new("UICorner")
KeyCorner.CornerRadius = UDim.new(0, 6)
KeyCorner.Parent = KeyBox

local GetBtn = Instance.new("TextButton")
GetBtn.Size = UDim2.new(0.35, 0, 0, 35)
GetBtn.Position = UDim2.new(0.1, 0, 0, 115)
GetBtn.Text = "GET KEY"
GetBtn.Font = Enum.Font.GothamBold
GetBtn.TextSize = 13
GetBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
GetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
GetBtn.Parent = Frame

local GetCorner = Instance.new("UICorner")
GetCorner.CornerRadius = UDim.new(0, 6)
GetCorner.Parent = GetBtn

local CheckBtn = Instance.new("TextButton")
CheckBtn.Size = UDim2.new(0.35, 0, 0, 35)
CheckBtn.Position = UDim2.new(0.55, 0, 0, 115)
CheckBtn.Text = "CHECK"
CheckBtn.Font = Enum.Font.GothamBold
CheckBtn.TextSize = 13
CheckBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
CheckBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CheckBtn.Parent = Frame

local CheckCorner = Instance.new("UICorner")
CheckCorner.CornerRadius = UDim.new(0, 6)
CheckCorner.Parent = CheckBtn

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(0.8, 0, 0, 40)
Status.Position = UDim2.new(0.1, 0, 0, 165)
Status.Text = HasScript and "✅ Script disponível!" or "❌ Sem script"
Status.TextColor3 = HasScript and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
Status.Font = Enum.Font.Gotham
Status.TextSize = 12
Status.BackgroundTransparency = 1
Status.TextWrapped = true
Status.Parent = Frame

GetBtn.MouseButton1Click:Connect(function()
    Status.Text = "Obtendo link..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 255)
    copyLink()
end)

CheckBtn.MouseButton1Click:Connect(function()
    local key = KeyBox.Text:gsub("%s+", "")
    if key == "" then
        Status.Text = "❌ Digite uma key!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    Status.Text = "⏳ Verificando..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 100)

    task.spawn(function()
        local success = verifyKey(key)
        if success then
            Status.Text = "✅ Key válida! Carregando..."
            Status.TextColor3 = Color3.fromRGB(100, 255, 100)
            if HasScript then
                local url = Scripts[CurrentPlaceId]
                if type(url) == "table" then
                    for _, u in ipairs(url) do
                        loadstring(game:HttpGet(u, true))()
                    end
                else
                    loadstring(game:HttpGet(url, true))()
                end
            end
            task.wait(2)
            ScreenGui:Destroy()
        else
            Status.Text = "❌ Key inválida ou erro"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end)

print("✅ PlatoBoost carregado!")
print("🌐 Host: " .. host)
print("🛡️  Proteções Delta ativadas")
