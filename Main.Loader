--// PlatoBoost Key System - SÓ A PARTE DO PLATOBOOST (com proteção Delta)
--// Configuração
local service = 4314;
local secret = "851b9074-f28e-427c-8cfe-aefac3e17b59";
local useNonce = true;

--// Scripts por Place ID
local Scripts = {
    ["100255403764514"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/memory%203",
    ["125998488582708"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Eternal%20nights",
    ["13803700382"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Fnaf%20Doom3",
    ["13803700135"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Fnaf%20Doom1",
    ["114413950886998"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Fatal%20Floor",
    ["12497348201"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Fnaf%20coop",
    ["14896802601"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/RMUH%20BETA",
    ["16667550979"] = "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/Night%202",
    ["140260816701736"] = {
        "https://api.junkie-development.de/api/v1/luascripts/public/82a88dd956eefd8282330506b0b50762b661e3506208eed8de60a7ac7aed6ff5/download",
        "https://raw.githubusercontent.com/DAVI98458/Nicescript/refs/heads/main/CABINS%2BSafeZone"
    }
}

local CurrentPlaceId = tostring(game.PlaceId)
local HasScript = Scripts[CurrentPlaceId] ~= nil

--// Aguardar jogo carregar
repeat task.wait(1) until game:IsLoaded();

--// Callback de mensagens
local onMessage = function(message) 
    print("[PlatoBoost] " .. message)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "PlatoBoost",
            Text = message,
            Duration = 3
        })
    end)
end

--// Funções do executor
local requestSending = false;
local fSetClipboard, fRequest, fStringChar, fToString, fStringSub, fOsTime, fMathRandom, fMathFloor, fGetHwid = 
    setclipboard or toclipboard, 
    request or http_request or syn_request, 
    string.char, 
    tostring, 
    string.sub, 
    os.time, 
    math.random, 
    math.floor, 
    gethwid or function() return game:GetService("Players").LocalPlayer.UserId end

local cachedLink, cachedTime = "", 0;

--// Verificar se fRequest existe (proteção Delta)
if not fRequest then
    onMessage("ERRO: HTTP Request não disponível neste executor!")
    error("HTTP Request não disponível")
end

--// Selecionar host
local host = "https://api.platoboost.com";

--// CORREÇÃO DELTA: Testar conectividade com pcall
local success, hostResponse = pcall(function()
    return fRequest({
        Url = host .. "/public/connectivity",
        Method = "GET"
    })
end)

if not success or not hostResponse or (hostResponse.StatusCode ~= 200 and hostResponse.StatusCode ~= 429) then
    host = "https://api.platoboost.net";
    print("[PlatoBoost] Usando host alternativo: " .. host)
end

--// Funções do PlatoBoost (OFICIAIS com proteção pcall)

function cacheLink()
    if cachedTime + (10*60) < fOsTime() then
        -- CORREÇÃO DELTA: pcall na requisição
        local success, response = pcall(function()
            return fRequest({
                Url = host .. "/public/start",
                Method = "POST",
                Body = lEncode({
                    service = service,
                    identifier = lDigest(fGetHwid())
                }),
                Headers = {
                    ["Content-Type"] = "application/json"
                }
            })
        end)

        if not success then
            local msg = "Erro de conexão (DNS). Use VPN!";
            onMessage(msg);
            return false, msg;
        end

        if response.StatusCode == 200 then
            local decoded = lDecode(response.Body);

            if decoded.success == true then
                cachedLink = decoded.data.url;
                cachedTime = fOsTime();
                return true, cachedLink;
            else
                onMessage(decoded.message);
                return false, decoded.message;
            end
        elseif response.StatusCode == 429 then
            local msg = "Rate limited, aguarde 20s";
            onMessage(msg);
            return false, msg;
        end

        local msg = "Falha ao obter link. Status: " .. response.StatusCode;
        onMessage(msg);
        return false, msg;
    else
        return true, cachedLink;
    end
end

--// Pré-carregar link
pcall(cacheLink)

local generateNonce = function()
    local str = ""
    for _ = 1, 16 do
        str = str .. fStringChar(fMathFloor(fMathRandom() * (122 - 97 + 1)) + 97)
    end
    return str
end

--// Teste de nonce
for _ = 1, 5 do
    local oNonce = generateNonce();
    task.wait(0.2)
    if generateNonce() == oNonce then
        local msg = "Erro de segurança (nonce)";
        onMessage(msg);
        error(msg);
    end
end

local copyLink = function()
    local success, link = cacheLink();

    if success then
        -- CORREÇÃO DELTA: pcall no setclipboard
        local clipSuccess = pcall(function()
            fSetClipboard(link);
        end)

        if not clipSuccess then
            print("=" .. string.rep("=", 40))
            print("LINK DO PLATOBOOST:")
            print(link)
            print("=" .. string.rep("=", 40))
            onMessage("Link no console (F9)!")
        end

        return true
    end
    return false
end

local redeemKey = function(key)
    local nonce = generateNonce();
    local endpoint = host .. "/public/redeem/" .. fToString(service);

    local body = {
        identifier = lDigest(fGetHwid()),
        key = key
    }

    if useNonce then
        body.nonce = nonce;
    end

    -- CORREÇÃO DELTA: pcall
    local success, response = pcall(function()
        return fRequest({
            Url = endpoint,
            Method = "POST",
            Body = lEncode(body),
            Headers = {
                ["Content-Type"] = "application/json"
            }
        })
    end)

    if not success then
        onMessage("Erro de conexão. Use VPN!");
        return false;
    end

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body);

        if decoded.success == true then
            if decoded.data.valid == true then
                if useNonce then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                        return true;
                    else
                        onMessage("Falha na verificação de segurança");
                        return false;
                    end    
                else
                    return true;
                end
            else
                onMessage("Key inválida");
                return false;
            end
        else
            if fStringSub(decoded.message, 1, 27) == "unique constraint violation" then
                onMessage("Você já tem uma key ativa");
                return false;
            else
                onMessage(decoded.message);
                return false;
            end
        end
    elseif response.StatusCode == 429 then
        onMessage("Rate limited, aguarde 20s");
        return false;
    else
        onMessage("Erro do servidor: " .. response.StatusCode);
        return false; 
    end
end

local verifyKey = function(key)
    if requestSending == true then
        onMessage("Aguarde, requisição em andamento...");
        return false;
    else
        requestSending = true;
    end

    local nonce = generateNonce();
    local endpoint = host .. "/public/whitelist/" .. fToString(service) .. "?identifier=" .. lDigest(fGetHwid()) .. "&key=" .. key;

    if useNonce then
        endpoint = endpoint .. "&nonce=" .. nonce;
    end

    -- CORREÇÃO DELTA: pcall
    local success, response = pcall(function()
        return fRequest({
            Url = endpoint,
            Method = "GET",
        })
    end)

    requestSending = false;

    if not success then
        onMessage("Erro de conexão. Use VPN!");
        return false;
    end

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body);

        if decoded.success == true then
            if decoded.data.valid == true then
                if useNonce then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                        return true;
                    else
                        onMessage("Falha na verificação de segurança");
                        return false;
                    end
                else
                    return true;
                end
            else
                if fStringSub(key, 1, 4) == "KEY_" then
                    return redeemKey(key);
                else
                    onMessage("Key inválida");
                    return false;
                end
            end
        else
            onMessage(decoded.message);
            return false;
        end
    elseif response.StatusCode == 429 then
        onMessage("Rate limited, aguarde 20s");
        return false;
    else
        onMessage("Erro do servidor: " .. response.StatusCode);
        return false;
    end
end

--// UI SIMPLES (para teste)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlatoBoost"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 300, 0, 200)
Frame.Position = UDim2.new(0.5, -150, 0.5, -100)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "PlatoBoost Key System"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.BackgroundTransparency = 1
Title.Parent = Frame

local KeyBox = Instance.new("TextBox")
KeyBox.Size = UDim2.new(0.8, 0, 0, 30)
KeyBox.Position = UDim2.new(0.1, 0, 0.3, 0)
KeyBox.PlaceholderText = "Digite sua key..."
KeyBox.Text = ""
KeyBox.Parent = Frame

local GetBtn = Instance.new("TextButton")
GetBtn.Size = UDim2.new(0.35, 0, 0, 30)
GetBtn.Position = UDim2.new(0.1, 0, 0.6, 0)
GetBtn.Text = "GET KEY"
GetBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
GetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
GetBtn.Parent = Frame

local CheckBtn = Instance.new("TextButton")
CheckBtn.Size = UDim2.new(0.35, 0, 0, 30)
CheckBtn.Position = UDim2.new(0.55, 0, 0.6, 0)
CheckBtn.Text = "CHECK KEY"
CheckBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
CheckBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CheckBtn.Parent = Frame

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(0.8, 0, 0, 30)
Status.Position = UDim2.new(0.1, 0, 0.8, 0)
Status.Text = ""
Status.TextColor3 = Color3.fromRGB(255, 255, 255)
Status.BackgroundTransparency = 1
Status.Parent = Frame

GetBtn.MouseButton1Click:Connect(function()
    Status.Text = "Obtendo link..."
    copyLink()
end)

CheckBtn.MouseButton1Click:Connect(function()
    local key = KeyBox.Text
    if key == "" then
        Status.Text = "Digite uma key!"
        return
    end
    Status.Text = "Verificando..."

    task.spawn(function()
        local success = verifyKey(key)
        if success then
            Status.Text = "✅ Key válida!"
            if HasScript then
                local url = Scripts[CurrentPlaceId]
                if type(url) == "table" then
                    for _, u in ipairs(url) do
                        loadstring(game:HttpGet(u, true))()
                    end
                else
                    loadstring(game:HttpGet(url, true))()
                end
            end
            task.wait(2)
            ScreenGui:Destroy()
        else
            Status.Text = "❌ Key inválida"
        end
    end)
end)

print("✅ PlatoBoost carregado!")
print("🌐 Host: " .. host)
