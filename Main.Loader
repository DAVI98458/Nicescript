--// Button Hover Effects
local function AddHoverEffect(button, originalColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor:Lerp(Color3.fromRGB(255, 255, 255), 0.1)}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
    end)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset, 0, 40)}):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset, 1, 0)}):Play()
    end)
end

AddHoverEffect(CheckButton, Color3.fromRGB(40, 180, 80))
AddHoverEffect(GetButton, Color3.fromRGB(30, 140, 240))

--// Functions
local function ShowStatus(message, isError)
    StatusLabel.Text = message
    StatusLabel.TextColor3 = isError and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(100, 255, 100)
    TweenService:Create(StatusLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    task.delay(3, function()
        TweenService:Create(StatusLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    end)
end

local function ExecuteScript()
    if not HasScript then
        ShowStatus("No script available for this game!", true)
        return
    end

    local scriptUrl = Scripts[CurrentPlaceId]

    if type(scriptUrl) == "table" then
        -- Multiple scripts
        for _, url in ipairs(scriptUrl) do
            pcall(function()
                loadstring(game:HttpGet(url, true))()
            end)
        end
    else
        -- Single script
        pcall(function()
            loadstring(game:HttpGet(scriptUrl, true))()
        end)
    end

    -- Close UI
    TweenService:Create(MainFrame, TweenInfo.new(0.5), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
    task.delay(0.5, function()
        ScreenGui:Destroy()
    end)
end

--// Button Connections
GetButton.MouseButton1Click:Connect(function()
    ShowStatus("⏳ Obtendo link...", false)

    task.spawn(function()
        local success, result = copyLink()
        if success then
            ShowStatus("✅ Link copiado!", false)
        else
            ShowStatus("❌ " .. tostring(result), true)
            warn("[PlatoBoost Error] " .. tostring(result))
        end
    end)
end)

CheckButton.MouseButton1Click:Connect(function()
    local key = KeyBox.Text:gsub("%s+", "")
    if key == "" then
        ShowStatus("❌ Digite uma key", true)
        return
    end

    ShowStatus("⏳ Verificando key...", false)

    task.spawn(function()
        local success, err = verifyKey(key)
        if success then
            ShowStatus("✅ Key válida! Carregando...", false)
            task.wait(1)
            ExecuteScript()
        else
            ShowStatus("❌ " .. tostring(err), true)
        end
    end)
end)

--// Intro Animation
MainFrame.Size = UDim2.new(0, 0, 0, 0)
MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
    Size = UDim2.new(0, 420, 0, 280),
    Position = UDim2.new(0.5, -210, 0.5, -140)
}):Play()

--// Drag Functionality
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

print("✅ Modern Key System Loaded | PlatoBoost Integration")
print("🔧 Executor detectado: " .. (fRequest and "Suporta HTTP" or "NÃO suporta HTTP"))
print("📋 Clipboard: " .. (fSetClipboard and "Disponível" or "Não disponível"))
