--// Button Hover Effects
local function AddHoverEffect(button, originalColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor:Lerp(Color3.fromRGB(255, 255, 255), 0.1)}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
    end)
end

AddHoverEffect(CheckButton, Color3.fromRGB(40, 180, 80))
AddHoverEffect(GetButton, Color3.fromRGB(30, 140, 240))

--// Functions
local function ShowStatus(message, isError)
    StatusLabel.Text = message
    StatusLabel.TextColor3 = isError and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
    TweenService:Create(StatusLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

    task.delay(4, function()
        TweenService:Create(StatusLabel, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    end)
end

local function ExecuteScript()
    if not HasScript then
        ShowStatus("Sem script para este jogo!", true)
        return
    end

    local scriptUrl = Scripts[CurrentPlaceId]

    if type(scriptUrl) == "table" then
        for _, url in ipairs(scriptUrl) do
            pcall(function()
                loadstring(game:HttpGet(url, true))()
            end)
        end
    else
        pcall(function()
            loadstring(game:HttpGet(scriptUrl, true))()
        end)
    end

    -- Close UI
    TweenService:Create(MainFrame, TweenInfo.new(0.5), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
    task.delay(0.5, function()
        ScreenGui:Destroy()
    end)
end

--// Button Connections
GetButton.MouseButton1Click:Connect(function()
    ShowStatus("Conectando...", false)

    task.spawn(function()
        local success, link = copyLink()
        if success then
            ShowStatus("Link obtido! Verifique o F9", false)
        else
            ShowStatus(tostring(link):sub(1, 50), true)
        end
    end)
end)

CheckButton.MouseButton1Click:Connect(function()
    local key = KeyBox.Text:gsub("%s+", "")
    if key == "" then
        ShowStatus("Digite uma key!", true)
        return
    end

    ShowStatus("Verificando...", false)

    task.spawn(function()
        local success, err = verifyKey(key)
        if success then
            ShowStatus("✅ Key válida! Carregando...", false)
            task.wait(1)
            ExecuteScript()
        else
            ShowStatus("❌ " .. tostring(err), true)
        end
    end)
end)

--// Intro Animation
MainFrame.Size = UDim2.new(0, 0, 0, 0)
MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
    Size = UDim2.new(0, 380, 0, 260),
    Position = UDim2.new(0.5, -190, 0.5, -130)
}):Play()

--// Drag Functionality (Melhorado para touch)
local dragging, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

print("✅ Delta Key System Loaded")
print("📱 Modo Mobile ativado")
print("💡 Dica: Se der erro de DNS, use o app 1.1.1.1 (VPN grátis)")
