--// Bibliotecas JSON e SHA256
local a = 2^32
local b = a - 1

local function c(d, e)
    local f, g = 0, 1
    while d ~= 0 or e ~= 0 do
        local h, i = d % 2, e % 2
        local j = (h + i) % 2
        f = f + j * g
        d = math.floor(d / 2)
        e = math.floor(e / 2)
        g = g * 2
    end
    return f % a
end

local function k(d, e, l, ...)
    local m
    if e then
        d = d % a
        e = e % a
        m = c(d, e)
        if l then
            m = k(m, l, ...)
        end
        return m
    elseif d then
        return d % a
    else
        return 0
    end
end

local function n(d, e, l, ...)
    local m
    if e then
        d = d % a
        e = e % a
        m = (d + e - c(d, e)) / 2
        if l then
            m = n(m, l, ...)
        end
        return m
    elseif d then
        return d % a
    else
        return b
    end
end

local function o(p)
    return b - p
end

local function q(d, r)
    if r < 0 then
        return lshift(d, -r)
    end
    return math.floor(d % 2^32 / 2^r)
end

local function s(p, r)
    if r > 31 or r < -31 then
        return 0
    end
    return q(p % a, r)
end

local function lshift(d, r)
    if r < 0 then
        return s(d, -r)
    end
    return d * 2^r % 2^32
end

local function t(p, r)
    p = p % a
    r = r % 32
    local u = n(p, 2^r - 1)
    return s(p, r) + lshift(u, 32 - r)
end

local v = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
}

local function w(x)
    return string.gsub(x, ".", function(l)
        return string.format("%02x", string.byte(l))
    end)
end

local function y(z, A)
    local x = ""
    for B = 1, A do
        local C = z % 256
        x = string.char(C) .. x
        z = (z - C) / 256
    end
    return x
end

local function D(x, B)
    local A = 0
    for B = B, B + 3 do
        A = A * 256 + string.byte(x, B)
    end
    return A
end

local function E(F, G)
    local H = 64 - (G + 9) % 64
    G = y(8 * G, 8)
    F = F .. "\128" .. string.rep("\0", H) .. G
    assert(#F % 64 == 0)
    return F
end

local function I(J)
    J[1] = 0x6a09e667
    J[2] = 0xbb67ae85
    J[3] = 0x3c6ef372
    J[4] = 0xa54ff53a
    J[5] = 0x510e527f
    J[6] = 0x9b05688c
    J[7] = 0x1f83d9ab
    J[8] = 0x5be0cd19
    return J
end

local function K(F, B, J)
    local L = {}
    for M = 1, 16 do
        L[M] = D(F, B + (M - 1) * 4)
    end
    for M = 17, 64 do
        local N = L[M - 15]
        local O = k(t(N, 7), t(N, 18), s(N, 3))
        N = L[M - 2]
        L[M] = (L[M - 16] + O + L[M - 7] + k(t(N, 17), t(N, 19), s(N, 10))) % a
    end
    local d, e, l, P, Q, R, S, T = J[1], J[2], J[3], J[4], J[5], J[6], J[7], J[8]
    for B = 1, 64 do
        local O = k(t(d, 2), t(d, 13), t(d, 22))
        local U = k(n(d, e), n(d, l), n(e, l))
        local V = (O + U) % a
        local W = k(t(Q, 6), t(Q, 11), t(Q, 25))
        local X = k(n(Q, R), n(o(Q), S))
        local Y = (T + W + X + v[B] + L[B]) % a
        T = S
        S = R
        R = Q
        Q = (P + Y) % a
        P = l
        l = e
        e = d
        d = (Y + V) % a
    end
    J[1] = (J[1] + d) % a
    J[2] = (J[2] + e) % a
    J[3] = (J[3] + l) % a
    J[4] = (J[4] + P) % a
    J[5] = (J[5] + Q) % a
    J[6] = (J[6] + R) % a
    J[7] = (J[7] + S) % a
    J[8] = (J[8] + T) % a
end

local function Z(F)
    F = E(F, #F)
    local J = I({})
    for B = 1, #F, 64 do
        K(F, B, J)
    end
    return w(y(J[1], 4) .. y(J[2], 4) .. y(J[3], 4) .. y(J[4], 4) .. y(J[5], 4) .. y(J[6], 4) .. y(J[7], 4) .. y(J[8], 4))
end

--// JSON Library simplificada para mobile
local function lEncode(M)
    local function encode(val)
        local t = type(val)
        if t == "nil" then
            return "null"
        elseif t == "boolean" then
            return tostring(val)
        elseif t == "number" then
            return string.format("%.14g", val)
        elseif t == "string" then
            return '"' .. val:gsub('[%z\1-\31\\"]', function(c)
                local esc = {["\\"] = "\\", ['"'] = '\"', ["\b"] = "b", ["\f"] = "f", ["\n"] = "n", ["\r"] = "r", ["\t"] = "t"}
                return "\\" .. (esc[c] or string.format("u%04x", c:byte()))
            end) .. '"'
        elseif t == "table" then
            local isArray = #val > 0
            local parts = {}
            if isArray then
                for i, v in ipairs(val) do
                    parts[i] = encode(v)
                end
                return "[" .. table.concat(parts, ",") .. "]"
            else
                local i = 1
                for k, v in pairs(val) do
                    parts[i] = encode(tostring(k)) .. ":" .. encode(v)
                    i = i + 1
                end
                return "{" .. table.concat(parts, ",") .. "}"
            end
        end
        error("Cannot encode " .. t)
    end
    return encode(M)
end

local function lDecode(str)
    local pos = 1
    local function skipWhitespace()
        while pos <= #str and str:sub(pos, pos):match("%s") do
            pos = pos + 1
        end
    end

    local function parseValue()
        skipWhitespace()
        local c = str:sub(pos, pos)
        if c == '"' then
            return parseString()
        elseif c == '{' then
            return parseObject()
        elseif c == '[' then
            return parseArray()
        elseif c == 't' or c == 'f' or c == 'n' then
            return parseLiteral()
        else
            return parseNumber()
        end
    end

    local function parseString()
        pos = pos + 1
        local result = ""
        while pos <= #str do
            local c = str:sub(pos, pos)
            if c == '"' then
                pos = pos + 1
                return result
            elseif c == '\\' then
                pos = pos + 1
                c = str:sub(pos, pos)
                if c == 'u' then
                    local hex = str:sub(pos + 1, pos + 4)
                    result = result .. utf8.char(tonumber(hex, 16))
                    pos = pos + 5
                else
                    local esc = {b = "\b", f = "\f", n = "\n", r = "\r", t = "\t"}
                    result = result .. (esc[c] or c)
                    pos = pos + 1
                end
            else
                result = result .. c
                pos = pos + 1
            end
        end
        error("Unterminated string")
    end

    local function parseObject()
        pos = pos + 1
        local obj = {}
        skipWhitespace()
        if str:sub(pos, pos) == '}' then
            pos = pos + 1
            return obj
        end
        while true do
            local key = parseValue()
            skipWhitespace()
            if str:sub(pos, pos) ~= ':' then error("Expected ':'") end
            pos = pos + 1
            local val = parseValue()
            obj[key] = val
            skipWhitespace()
            local c = str:sub(pos, pos)
            pos = pos + 1
            if c == '}' then
                return obj
            elseif c ~= ',' then
                error("Expected ',' or '}'")
            end
        end
    end

    local function parseArray()
        pos = pos + 1
        local arr = {}
        skipWhitespace()
        if str:sub(pos, pos) == ']' then
            pos = pos + 1
            return arr
        end
        while true do
            table.insert(arr, parseValue())
            skipWhitespace()
            local c = str:sub(pos, pos)
            pos = pos + 1
            if c == ']' then
                return arr
            elseif c ~= ',' then
                error("Expected ',' or ']'")
            end
        end
    end

    local function parseLiteral()
        if str:sub(pos, pos + 3) == "true" then
            pos = pos + 4
            return true
        elseif str:sub(pos, pos + 4) == "false" then
            pos = pos + 5
            return false
        elseif str:sub(pos, pos + 3) == "null" then
            pos = pos + 4
            return nil
        end
        error("Invalid literal")
    end

    local function parseNumber()
        local start = pos
        while pos <= #str and str:sub(pos, pos):match("[%-%d%.eE%+%-]") do
            pos = pos + 1
        end
        return tonumber(str:sub(start, pos - 1))
    end

    return parseValue()
end

local lDigest = Z

--// PlatoBoost Functions
local requestSending = false
local cachedLink, cachedTime = "", 0

--// Verificar se fRequest existe
if not fRequest then
    warn("⚠️ Delta: HTTP Request não detectado!")
end

local function generateNonce()
    local str = ""
    for _ = 1, 16 do
        str = str .. string.char(math.floor(math.random() * (122 - 97 + 1)) + 97)
    end
    return str
end

local function tryRequest(url, method, body, headers)
    if not fRequest then
        return nil, "HTTP não disponível"
    end

    -- Delta às vezes precisa de headers específicos
    local fullHeaders = headers or {}
    fullHeaders["User-Agent"] = fullHeaders["User-Agent"] or "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

    local success, response = pcall(function()
        return fRequest({
            Url = url,
            Method = method or "GET",
            Body = body,
            Headers = fullHeaders
        })
    end)

    if not success then
        -- Tentar com game:HttpGet como último recurso
        if method == "GET" then
            return httpGetFallback(url)
        end
        return nil, tostring(response)
    end

    return response
end

local function cacheLink()
    if cachedTime + (10 * 60) > os.time() and cachedLink ~= "" then
        return true, cachedLink
    end

    local hwid = fGetHwid()
    local identifier = lDigest(hwid)

    -- Tentar cada host
    for i, host in ipairs(hosts) do
        local response, err = tryRequest(
            host .. "/public/start",
            "POST",
            lEncode({
                service = service,
                identifier = identifier
            }),
            { ["Content-Type"] = "application/json" }
        )

        if response and response.StatusCode == 200 then
            local success, decoded = pcall(function()
                return lDecode(response.Body)
            end)

            if success and decoded and decoded.success == true then
                cachedLink = decoded.data.url
                cachedTime = os.time()
                currentHostIndex = i
                return true, cachedLink
            elseif success and decoded then
                return false, decoded.message or "Erro desconhecido"
            else
                return false, "Erro ao decodificar JSON"
            end
        end
    end

    return false, "Falha de conexão. Tente:
1. Usar VPN (1.1.1.1)
2. Mudar DNS do WiFi
3. Reiniciar o jogo"
end

local function copyLink()
    local success, link = cacheLink()
    if success then
        -- Tentar copiar para clipboard
        local clipSuccess = pcall(function()
            fSetClipboard(link)
        end)

        -- Mostrar notificação no mobile
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = clipSuccess and "✅ Link Copiado!" or "📋 Link no Console",
            Text = clipSuccess and "Cole no navegador" or "Aperte F9 e copie o link",
            Duration = 5
        })

        -- Sempre mostrar no console também (para mobile)
        if not clipSuccess then
            print("=" .. string.rep("=", 50))
            print("🔗 LINK DO PLATOBOOST:")
            print(link)
            print("=" .. string.rep("=", 50))
        end

        return true, link
    end
    return false, link
end

local function redeemKey(key)
    local nonce = generateNonce()
    local endpoint = hosts[currentHostIndex] .. "/public/redeem/" .. tostring(service)
    local body = { 
        identifier = lDigest(fGetHwid()), 
        key = key 
    }
    if useNonce then 
        body.nonce = nonce 
    end

    local response, err = tryRequest(
        endpoint,
        "POST",
        lEncode(body),
        { ["Content-Type"] = "application/json" }
    )

    if not response then
        return false, "Erro na conexão"
    end

    if response.StatusCode == 200 then
        local success, decoded = pcall(function()
            return lDecode(response.Body)
        end)

        if not success or not decoded then
            return false, "Erro ao ler resposta"
        end

        if decoded.success and decoded.data and decoded.data.valid then
            if useNonce then
                if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                    return true
                else
                    return false, "Erro de segurança"
                end
            else
                return true
            end
        else
            return false, "Key inválida"
        end
    elseif response.StatusCode == 429 then
        return false, "Muitas tentativas. Aguarde."
    end

    return false, "Erro do servidor"
end

local function verifyKey(key)
    if requestSending then 
        return false, "Aguarde..." 
    end

    requestSending = true

    local nonce = generateNonce()
    local endpoint = hosts[currentHostIndex] .. "/public/whitelist/" .. tostring(service) .. "?identifier=" .. lDigest(fGetHwid()) .. "&key=" .. key
    if useNonce then 
        endpoint = endpoint .. "&nonce=" .. nonce 
    end

    local response, err = tryRequest(endpoint, "GET")

    requestSending = false

    if not response then
        return false, "Sem conexão. Use VPN."
    end

    if response.StatusCode == 200 then
        local success, decoded = pcall(function()
            return lDecode(response.Body)
        end)

        if not success or not decoded then
            return false, "Erro ao processar"
        end

        if decoded.success and decoded.data and decoded.data.valid then
            if useNonce then
                if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                    return true
                else
                    return false, "Erro de validação"
                end
            else
                return true
            end
        else
            if string.sub(key, 1, 4) == "KEY_" then
                return redeemKey(key)
            else
                return false, "Key incorreta"
            end
        end
    elseif response.StatusCode == 429 then
        return false, "Muitas tentativas (20s)"
    end

    return false, "Erro " .. response.StatusCode
end

