-- Hover effects
local function addHover(btn, color)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = color:Lerp(Color3.fromRGB(255,255,255), 0.1)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = color}):Play()
    end)
end

addHover(getBtn, Color3.fromRGB(30, 140, 240))
addHover(checkBtn, Color3.fromRGB(40, 180, 80))

-- Conexões
getBtn.MouseButton1Click:Connect(function()
    statusLabel.Text = "Obtendo link..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    copyLink()
end)

checkBtn.MouseButton1Click:Connect(function()
    local key = keyBox.Text:gsub("%s+", "")
    if key == "" then
        statusLabel.Text = "❌ Digite uma key!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    statusLabel.Text = "⏳ Verificando..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)

    task.spawn(function()
        if verifyKey(key) then
            statusLabel.Text = "✅ Key válida! Executando..."
            statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

            -- Executar script do Place ID
            if HasScript then
                local scriptUrl = Scripts[CurrentPlaceId]
                if type(scriptUrl) == "table" then
                    for _, url in ipairs(scriptUrl) do
                        pcall(function()
                            loadstring(game:HttpGet(url, true))()
                        end)
                    end
                else
                    pcall(function()
                        loadstring(game:HttpGet(scriptUrl, true))()
                    end)
                end
            end

            task.wait(2)
            TweenService:Create(frame, TweenInfo.new(0.5), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
            task.wait(0.5)
            screenGui:Destroy()
        else
            statusLabel.Text = "❌ Key inválida"
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end)

-- Animação de entrada
frame.Size = UDim2.new(0, 0, 0, 0)
